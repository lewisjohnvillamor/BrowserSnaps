{
  "manifest_version": 3,
  "name": "BrowserSnaps",
  "description": "Capture selected navigation pages at multiple screen sizes into one PDF.",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "author": "Lewis John Villamor",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "offscreen",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "BrowserSnaps",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
