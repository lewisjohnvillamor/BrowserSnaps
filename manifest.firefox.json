{
  "manifest_version": 3,
  "name": "BrowserSnaps",
  "description": "Capture selected navigation pages at multiple screen sizes as PDF or PNG.",
  "version": "1.8.0",
  "author": "Lewis John Villamor",
  "homepage_url": "https://github.com/lewisjohnvillamor/BrowserSnaps",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "background": {
    "scripts": [
      "src/storage.js",
      "src/indicator.js",
      "src/audit.js",
      "src/perf.js",
      "src/tech.js",
      "src/offscreen.js",
      "src/platform-firefox.js",
      "src/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browsersnaps@lewisjohnvillamor.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_title": "BrowserSnaps",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
