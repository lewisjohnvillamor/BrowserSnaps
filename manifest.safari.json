{
  "manifest_version": 3,
  "name": "BrowserSnaps",
  "description": "Capture selected navigation pages at multiple screen sizes as PDF or PNG.",
  "version": "1.4.2",
  "author": "Lewis John Villamor",
  "homepage_url": "https://github.com/lewisjohnvillamor/BrowserSnaps",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "background": {
    "scripts": [
      "src/storage.js",
      "src/offscreen.js",
      "src/platform-safari.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "BrowserSnaps",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
